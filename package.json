{
  "name": "cloud-form",
  "private": true,
  "type": "module",
  "cloudflare": {
    "bindings": {
      "DB": {
        "description": "D1 database for users, forms, submissions metadata, and audit log."
      },
      "FILES": {
        "description": "R2 bucket for form uploads (pending and submission attachments)."
      }
    }
  },
  "scripts": {
    "dev": "wrangler d1 migrations apply DB --local && vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "db:migrations:apply": "wrangler d1 migrations apply DB --remote",
    "deploy": "npm run build && wrangler deploy && npm run db:migrations:apply",
    "cf-typegen": "wrangler types",
    "test": "vitest run"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@oslojs/crypto": "^1.0.1",
    "@oslojs/encoding": "^1.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.38",
    "@tanstack/react-start": "^1.168.56",
    "@tanstack/react-table": "^9.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.3.0",
    "libphonenumber-js": "^1.13.13",
    "lucide-react": "^1.47.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-phone-number-input": "^3.4.18",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.56.0",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "latest",
    "@types/node": "^22.5.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/runner": "^4.1.11",
    "@vitest/snapshot": "^4.1.11",
    "typescript": "^5.8.2",
    "vite": "^7.1.5",
    "vitest": "^4.1.11",
    "wrangler": "^4.135.0"
  },
  "overrides": {
    "sharp": "^0.35.4"
  }
}
