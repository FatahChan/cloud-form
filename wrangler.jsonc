{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cloud-form",
	"main": "@tanstack/react-start/server-entry",
	"compatibility_date": "2026-08-22",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"workers_dev": true,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "cloud-form-db",
			"migrations_dir": "migrations",
		}
	],
	"r2_buckets": [
		{
			"binding": "FILES",
			"bucket_name": "cloud-form-files"
		}
	]
}
