{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cloud-form",
	"main": "src/server.ts",
	"compatibility_date": "2026-08-22",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"workers_dev": true,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "cloud-form-db",
			"migrations_dir": "migrations",
		}
	],
	"r2_buckets": [
		{
			"binding": "FILES",
			"bucket_name": "cloud-form-files"
		}
	],
	// namespace_id is account-wide: another Worker reusing these IDs would share the counters.
	"ratelimits": [
		{
			"name": "AUTH_LIMITER",
			"namespace_id": "73101",
			"simple": { "limit": 10, "period": 60 }
		},
		{
			"name": "PUBLIC_LIMITER",
			"namespace_id": "73102",
			"simple": { "limit": 30, "period": 60 }
		}
	],
	"triggers": {
		"crons": ["0 * * * *"]
	}
}
